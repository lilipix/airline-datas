{
  "name": "Big Data Lakehouse — PySpark 4.2 & Delta Lake 4.4 (spark-jupyter)",
  "dockerComposeFile": [
    "../docker-compose.yml"
  ],
  "service": "spark-jupyter",
  "workspaceFolder": "/workspace",
  "initializeCommand": "docker compose build",
  "overrideCommand": false,
  "shutdownAction": "none",

  "forwardPorts": [
    9870,
    8888,
    4040,
    8501
  ],
  "portsAttributes": {
    "9870": {
      "label": "HDFS NameNode UI",
      "onAutoForward": "Silent"
    },
    "8888": {
      "label": "JupyterLab Web (token: bigdata)",
      "onAutoForward": "Silent"
    },
    "4040": {
      "label": "Spark Web UI (DAG & Shuffle)",
      "onAutoForward": "notify"
    },
    "8501": {
      "label": "Dashboard Streamlit (Gold)",
      "onAutoForward": "Silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "mechatroner.rainbow-csv",
        "redhat.vscode-xml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "jupyter.kernels.trusted": [
          "/usr/local/share/jupyter/kernels/python3/kernel.json"
        ],
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
